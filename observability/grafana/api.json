{
  "title": "CDN Manager / API, SSO and MCP",
  "uid": "cdn-manager-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "tags": [
    "cdn-manager"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{route}} {{method}}",
          "expr": "sum by (route, method) (rate(cdn_manager_http_requests_total{route=~\"/(api/v1|auth|mcp).*\"}[$__rate_interval]))",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP errors by status",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{route}} {{status}}",
          "expr": "sum by (route, status) (rate(cdn_manager_http_requests_total{route=~\"/(api/v1|auth|mcp).*\",status=~\"[45]..\"}[$__rate_interval]))",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP request duration, p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{route}}",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(cdn_manager_http_request_duration_seconds_bucket{route=~\"/(api/v1|auth|mcp).*\"}[$__rate_interval])))",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "title": "SSO and MCP requests by result",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{route}} {{status}}",
          "expr": "sum by (route, status) (rate(cdn_manager_http_requests_total{route=~\"/(auth|mcp).*\",status=~\"[2345]..\"}[$__rate_interval]))",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "title": "OAuth and permission denials",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{route}} {{status}}",
          "expr": "sum by (route, status) (rate(cdn_manager_http_requests_total{route=~\"/(api/v1|auth|mcp).*\",status=~\"401|403\"}[$__rate_interval]))",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Manager memory",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{instance}} resident",
          "expr": "process_resident_memory_bytes and on (job, instance) (cdn_manager_source_available >= 0)",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "{{instance}} Go heap",
          "expr": "go_memstats_heap_alloc_bytes and on (job, instance) (cdn_manager_source_available >= 0)",
          "instant": false,
          "range": true
        }
      ]
    }
  ]
}
